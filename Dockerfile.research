FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/ ./
RUN npm install --ignore-scripts --no-audit --no-fund && npm run check && npm run build
FROM python:3.12-slim
WORKDIR /srv
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./backend/app
COPY data/reference ./data/reference
COPY --from=frontend /build/public-build ./public-build
RUN mkdir -p /srv/private && chown -R 10001:10001 /srv/private
USER 10001:10001
ENV PYTHONPATH=/srv/backend NEPSE_PUBLIC_FRONTEND=/srv/public-build NEPSE_API_DATABASE=/srv/private/market.duckdb NEPSE_PRIVATE_DB=/srv/private/accounts.sqlite3 NEPSE_DEPLOYMENT_MODE=private NEPSE_REQUIRE_QUARANTINE_LEDGER=1
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1"]
