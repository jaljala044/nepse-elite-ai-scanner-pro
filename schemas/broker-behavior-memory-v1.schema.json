{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepse-elite-ai-scanner-pro/schemas/broker-behavior-memory-v1.json",
  "title": "Broker Security Behaviour Memory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_date", "security_id", "broker_entity_id", "window", "observed_sessions", "buy_amount", "sell_amount", "net_amount", "source_ids", "evidence_ids", "payload_hashes", "max_available_at", "status"],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "security_id": {"type": "string", "minLength": 1},
    "broker_entity_id": {"type": "string", "minLength": 1},
    "window": {"enum": ["daily", "weekly", "monthly", "yearly"]},
    "observed_sessions": {"type": "integer", "minimum": 1},
    "buy_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "sell_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "net_amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "payload_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "max_available_at": {"type": "string", "format": "date"},
    "coverage_min": {"type": "string"},
    "status": {"const": "descriptive_only"},
    "interpretation": {"type": "string"}
  }
}
